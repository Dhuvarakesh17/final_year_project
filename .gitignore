# ==============================================================================
# AgroVision Intelligence AI — Git Ignore Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Virtual Environments & Python Packages
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
develop-eggs/
.installed.cfg

# Local wheel archives (CRITICAL: PyTorch CUDA wheel is 2.45 GB)
*.whl
ml_models/*.whl

# ------------------------------------------------------------------------------
# 2. Node & Frontend Build Artifacts
# ------------------------------------------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Machine Learning Datasets & Training Run Artifacts
# ------------------------------------------------------------------------------
# Raw multi-gigabyte training image datasets (PlantVillage 16k, DeepWeeds 10k)
data/datasets/
datasets/

# YOLO & PyTorch intermediate training checkpoints and runs
runs/
ml_models/training/
ml_models/Ultralytics/
Ultralytics/
/weights/

# Base generic pre-trained weights (if in root)
/yolov8n.pt

# Fine-tuned project model weights (<25MB total) are tracked so anyone
# cloning can run the live pipeline out-of-the-box without GPU retraining:
!ml_models/weights/*.pt
!ml_models/weights/*.json
!ml_models/weights/.gitkeep

# ------------------------------------------------------------------------------
# 4. Pipeline Runtime Data & Media Files
# ------------------------------------------------------------------------------
# Video footage (drone footage, test videos, uploaded recordings)
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Extracted frames, crops, masks, and generated PDF reports
data/raw_videos/*
data/extracted_frames/*
data/evidence/*
data/reports/*

# Preserve directory structure in Git via .gitkeep
!data/raw_videos/.gitkeep
!data/extracted_frames/.gitkeep
!data/evidence/.gitkeep
!data/reports/.gitkeep
!ml_models/weights/.gitkeep

# ------------------------------------------------------------------------------
# 5. Local Databases, State & Secrets
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
crop_monitoring.db
*.env
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & OS Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 7. Logs & Testing Caches
# ------------------------------------------------------------------------------
*.log
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
